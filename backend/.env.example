# --- Database (Koyeb Postgres v18, Singapore) ---
# Copy from Koyeb dashboard: Database -> Connection details -> .env
# Example: postgresql://koyeb-adm:<password>@ep-noisy-dream-aoenu83k.c-2.ap-southeast-1.pg.koyeb.app/koyebdb
DATABASE_URL=postgresql://user:password@host:5432/koyebdb?sslmode=require
# Optional pooled URL for serverless; otherwise same as DATABASE_URL
# DIRECT_URL=postgresql://user:password@host:5432/koyebdb?sslmode=require

# --- Server ---
PORT=5001
NODE_ENV=production
FRONTEND_URL=https://blink.koyeb.app
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars

# --- Cloudinary (media uploads) ---
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
CLOUDINARY_CLOUD_NAME=api_cloud_name

# --- Help center seed user ---
HELP_CENTER_EMAIL=help@example.com
HELP_CENTER_PASSWORD=change_me

# --- Web push (VAPID) ---
VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VITE_VAPID_PUBLIC_KEY=your_public_vapid_key
# Giphy SDK key (free at developers.giphy.com/dashboard) — GIF + sticker search
VITE_GIPHY_KEY=your_giphy_api_key
VITE_HELP_CENTER_EMAIL=help@example.com
